# ============================================
# SMARTLIB — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# All passwords below are DEVELOPMENT-ONLY defaults.
# ============================================

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=smartlib_dev_secret_change_in_production_2024
JWT_EXPIRES_IN=7d

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=smartlib

# MongoDB
MONGODB_URI=mongodb://localhost:27017/smartlib

# Fine Configuration
FINE_PER_DAY=2
LOAN_PERIOD_DAYS=14
MAX_ACTIVE_LOANS=3

# Library Timezone (IST)
LIBRARY_TIMEZONE=Asia/Kolkata

# Upload Directory
UPLOAD_DIR=frontend/assets/images/uploads
